    "branch-cleanup"
  ],
  "projectTypes": [
    "generic"
  ],
  "license": "MIT",
  "repository": {
    "url": "https://github.com/lozymon/airules",
    "directory": "skills/commit-cleanup"
  },
  "targets": {
